<!DOCTYPE html>
<html>
<head>
    <title>LATIHAN FORM DALAM HTML</title>
</head>
<body>
    <form name="formulir" action="" method="post">
        <table width="100%" border="1">
            <tr>
                <td colspan="2" height="100px" align="center">
                    HEADER
                </td>
            </tr>
            <tr>
                <td valign="top" width="200px">
                    <a href="index.html">Home</a><br/>
                    <a href="registrasi.html">Registrasi</a>
                </td>
                <td>
                    <div align="center">
                        <font size="+2">
                            Pendaftaran Account Baru
                        </font>
                        <br/>
                        <b>FACEBOOK</b>
                        <br/>
                        The first Indonesian high school network.
                    </div>
                    <table align="center" width="700px" border="1">
                        <tr>
                            <td>Nama Lengkap</td>
                            <td>
                                <input type="text" name="nama">
                            </td>
                        </tr>
                        <tr>
                            <td>Gender</td>
                            <td>
                                <input type="radio" name="gender"> Pria
                                <input type="radio" name="gender"> Wanita
                            </td>
                        </tr>
                        <tr>
                            <td>Hobi</td>
                            <td>
                                <input type="checkbox" name="main_bola"> Pria<br/>
                                <input type="checkbox" name="bulutangkis"> Wanita<br/>
                                <input type="checkbox" name="musik"> Musik<br/>
                            </td>
                        </tr>
                        <tr>
                            <td>Nomor HP</td>
                            <td>
                                <input type="text" name="hp">
                            </td>
                        </tr>
                        <tr>
                            <td>Kota</td>
                            <td>
                                <select name="kota" size="1">
                                    <option>Jakarta</option>
                                    <option>Bandung</option>
                                    <option>Bekasi</option>
                                    <option>Bogor</option>
                                    <option>Sukabumi</option>
                                    <option>Depok</option>
                                    <option>Cianjur</option>
                                </select>
                            </td>
                        </tr>
                        <tr>
                            <td>Alamat</td>
                            <td>
                                <textarea name="alamat" cols="20" rows="5"></textarea>
                            </td>
                        </tr>
                        <tr>
                            <td>Bio</td>
                            <td>
                                <input type="text" name="bio">
                            </td>
                        </tr>
                        <tr>
                            <td>Username</td>
                            <td>
                                <input type="text" name="username">
                            </td>
                        </tr>
                        <tr>
                            <td>Password</td>
                            <td>
                                <input type="password" name="password">
                            </td>
                        </tr>
                        <tr>
                            <td colspan="2" align="center">
                                <input type="submit" name="kirim" value="kirim">
                                <input type="reset" name="batal" value="reset">
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
            <tr>
                <td colspan="2" height="50px" align="center">
                    <b>enjoy</b> ESS - Indonesian High School Student Community
                </td>
            </tr>
        </table>
    </form>
</body>
</html>